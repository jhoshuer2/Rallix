# Copy to .env.local. Never commit real values.
# Web app role (RLS applies). On Supabase use the pooled connection string.
DATABASE_URL_APP=postgres://rallix_app:app_dev@localhost:5432/rallix_dev
# Server-only role for auth and the stats engine (BYPASSRLS). Never expose to the browser.
DATABASE_URL_SERVICE=postgres://rallix_service:service_dev@localhost:5432/rallix_dev
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000

# Payments. Development uses a local fake provider. Production must set paystack and a SECRET key.
# PAYMENTS_PROVIDER=paystack
# PAYSTACK_SECRET_KEY=sk_test_xxx   # sk_live_xxx in production. Server-only: never expose to the browser.
# Public URL of this app (used for the Paystack return link):
APP_URL=http://localhost:3000
PAYMENTS_PROVIDER=fake

# Email (sign-in codes, receipts). Development prints emails to the server log instead of sending.
# In production use SMTP and a sender on a domain you have verified (see packages/mailer/README.md).
MAIL_PROVIDER=console
MAIL_FROM=Rallix <no-reply@rallix.test>
# MAIL_PROVIDER=smtp
# SMTP_URL=smtps://user:pass@smtp.yourprovider.com:465
# MAIL_REPLY_TO=support@yourdomain.com

# Dues reminders. UNSUBSCRIBE_SECRET must be IDENTICAL in the club app and the console (links the console sends are verified by the club app).
# CRON_SECRET protects the daily job URL. Use long random values (openssl rand -hex 32) in production.
UNSUBSCRIBE_SECRET=change-me-to-a-long-random-value
CRON_SECRET=change-me-to-a-long-random-value
