# Copy to .env.local. The console only ever uses the service role (BYPASSRLS), so keep this app private.
DATABASE_URL_SERVICE=postgres://rallix_service:service_dev@localhost:5432/rallix_dev
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3001

# Public URL of the club app, used to build pay links for invoices:
CLUB_APP_URL=http://localhost:3000

# Email (staff sign-in codes, invoice emails, broadcasts). Development prints to the server log.
MAIL_PROVIDER=console
MAIL_FROM=Rallix <no-reply@rallix.test>
# MAIL_PROVIDER=smtp
# SMTP_URL=smtps://user:pass@smtp.yourprovider.com:465
# MAIL_REPLY_TO=support@yourdomain.com
# Dev only: addresses that always fail to send, to test failure handling
# MAIL_FAIL_ADDRESSES=fail@example.com
