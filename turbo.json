{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "lint": {},
    "test": {}
  },
  "globalPassThroughEnv": [
    "DATABASE_URL_APP",
    "DATABASE_URL_SERVICE",
    "DATABASE_URL_OWNER",
    "DATABASE_SSL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "APP_URL",
    "CLUB_APP_URL",
    "UNSUBSCRIBE_SECRET",
    "CRON_SECRET",
    "PAYMENTS_PROVIDER",
    "PAYSTACK_SECRET_KEY",
    "MAIL_PROVIDER",
    "SMTP_URL",
    "MAIL_FROM",
    "MAIL_REPLY_TO",
    "MAIL_FAIL_ADDRESSES"
  ]
}
